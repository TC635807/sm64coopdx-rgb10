diff --git a/src/pc/controller/controller_sdl.c b/src/pc/controller/controller_sdl.c
index b6d2ef3..8f170e5 100644
--- a/src/pc/controller/controller_sdl.c
+++ b/src/pc/controller/controller_sdl.c
@@ -205,6 +205,9 @@ static inline void update_analog_stick(s8 *stick_x, s8 *stick_y,
 }
 
 extern s16 gMenuMode;
+// RGB10 port: set by the Select+Start hotkey, consumed by the main loop.
+bool gRgb10QuitRequested = false;
+
 static void controller_sdl_read(OSContPad *pad) {
     if (!init_ok) { return; }
 
@@ -344,6 +347,24 @@ static void controller_sdl_read(OSContPad *pad) {
     update_analog_stick(&pad->stick_x, &pad->stick_y, leftx, lefty);
     update_analog_stick(&pad->ext_stick_x, &pad->ext_stick_y, rightx, righty);
 
+    // RGB10 port: hold Select (BACK) + Start for 1.5 s to quit cleanly back to the
+    // EmulationStation frontend (the on-screen Quit menu is hard to reach on this device).
+    if (sdl_cntrl != NULL) {
+        static u32 quit_hold_start = 0;
+        const bool quit_back  = SDL_GameControllerGetButton(sdl_cntrl, SDL_CONTROLLER_BUTTON_BACK);
+        const bool quit_start = SDL_GameControllerGetButton(sdl_cntrl, SDL_CONTROLLER_BUTTON_START);
+        if (quit_back && quit_start) {
+            const u32 now = SDL_GetTicks();
+            if (quit_hold_start == 0) {
+                quit_hold_start = now;
+            } else if ((u32)(now - quit_hold_start) >= 1500) {
+                gRgb10QuitRequested = true;
+            }
+        } else {
+            quit_hold_start = 0;
+        }
+    }
+
     // RGB10 port:
     // - D-pad emulates the left stick (character movement); the JPAD bits are stripped
     //   so the game does not also rotate the camera with them.
